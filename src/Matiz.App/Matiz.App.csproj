<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\matiz.ico</ApplicationIcon>
    <Product>Matiz</Product>
    <AssemblyTitle>Matiz</AssemblyTitle>
    <AssemblyName>Matiz</AssemblyName>
    <RootNamespace>Matiz.App</RootNamespace>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Matiz.Core\Matiz.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\matiz.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Matiz.App.Tests" />
  </ItemGroup>

</Project>
