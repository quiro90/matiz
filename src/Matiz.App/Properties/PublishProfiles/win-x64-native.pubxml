<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/Matiz.App -p:PublishProfile=win-x64-native   (o .\build.ps1 native)
     Lo más "nativo" posible con WPF sin cambiar código (Native AOT no es compatible con WPF):
     - SelfContained: incluye el runtime; no requiere tener .NET instalado.
     - PublishSingleFile: un único Matiz.exe (las DLL nativas de WPF se extraen al ejecutar).
     - PublishReadyToRun + Composite: app y framework precompilados juntos a código máquina (menos JIT al arrancar).
     - Sin compresión: ~143 MB pero arranque ~0,7 s. Con -p:EnableCompressionInSingleFile=true: ~65 MB y ~0,9 s.
     - Sin trimming: WPF no lo soporta de forma fiable (usa reflexión desde XAML). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>..\..\publish\win-x64-native\</PublishDir>
  </PropertyGroup>
</Project>
