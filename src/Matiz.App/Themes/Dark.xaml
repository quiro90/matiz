<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens Dark: superficies en grises neutros (croma nula) para no interferir con los colores analizados. -->
    <SolidColorBrush x:Key="BgBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#222222"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#343434"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A3A3A3"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#6F6F6F"/>
    <SolidColorBrush x:Key="InverseBgBrush" Color="#EDEDED"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#222222"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#99000000"/>
    <SolidColorBrush x:Key="CheckerLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckerDarkBrush" Color="#CCCCCC"/>
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
