<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tokens Light: superficies en grises neutros (croma nula) para no interferir con los colores analizados. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F6F6F6"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="LineBrush" Color="#DCDCDC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="InverseBgBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="InverseTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D93036"/>
    <SolidColorBrush x:Key="OverlayBrush" Color="#55000000"/>
    <SolidColorBrush x:Key="CheckerLightBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CheckerDarkBrush" Color="#CCCCCC"/>
    <Color x:Key="ShadowColor">#40000000</Color>
</ResourceDictionary>
