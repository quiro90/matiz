<Window x:Class="Matiz.App.Views.ExportImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar paleta como imagen" Icon="/Matiz;component/Assets/matiz.ico" Width="920" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="Preview" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Vista previa"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="2">
            <TextBlock Text="ORIENTACIÓN" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Horizontal" Style="{StaticResource Segment}" Content="Horizontal" GroupName="o" IsChecked="True" Checked="OnOptionChanged"/>
                <RadioButton Style="{StaticResource Segment}" Content="Vertical" GroupName="o" Checked="OnOptionChanged"/>
            </StackPanel>

            <TextBlock Text="TAMAÑO" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Scale1" Style="{StaticResource Segment}" Content="1×" GroupName="s" Checked="OnOptionChanged"/>
                <RadioButton x:Name="Scale2" Style="{StaticResource Segment}" Content="2×" GroupName="s" IsChecked="True" Checked="OnOptionChanged"/>
                <RadioButton x:Name="Scale3" Style="{StaticResource Segment}" Content="3×" GroupName="s" Checked="OnOptionChanged"/>
            </StackPanel>

            <TextBlock Text="FONDO" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="LightBg" Style="{StaticResource Segment}" Content="Claro" GroupName="b" IsChecked="True" Checked="OnOptionChanged"/>
                <RadioButton Style="{StaticResource Segment}" Content="Oscuro" GroupName="b" Checked="OnOptionChanged"/>
            </StackPanel>

            <TextBlock Text="INFORMACIÓN" Style="{StaticResource SectionTitle}" Margin="0,16,0,2"/>
            <TextBlock Text="Nombre, HEX y RGB siempre" Style="{StaticResource Muted}" FontSize="11.5"/>
            <CheckBox x:Name="ShowHsl" Style="{StaticResource Switch}" Content="HSL" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>
            <CheckBox x:Name="ShowCmyk" Style="{StaticResource Switch}" Content="CMYK (aprox.)" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

            <TextBlock x:Name="SizeText" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,16,0,0"/>

            <Button Style="{StaticResource PrimaryButton}" Content="Guardar PNG…" Click="Save_Click" Margin="0,18,0,0" Padding="12,8" IsDefault="True"/>
            <Button Content="Copiar imagen" Click="CopyImage_Click" Margin="0,8,0,0" Padding="12,6"/>
            <Button Content="Cerrar" Click="Close_Click" Margin="0,8,0,0" Padding="12,6" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
