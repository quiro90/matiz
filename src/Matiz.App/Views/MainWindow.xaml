<Window x:Class="Matiz.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Matiz.App.Controls"
        xmlns:vm="clr-namespace:Matiz.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}" Icon="/Matiz;component/Assets/matiz.ico" Width="1060" Height="740" MinWidth="820" MinHeight="600"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Topmost="{Binding AlwaysOnTop}" AllowDrop="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Sin barra de título del sistema: la barra superior hace de zona de arrastre (snap y redimensionado se conservan). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú "Copiar como" para el color actual -->
        <ContextMenu x:Key="CopyAsMenu" ItemsSource="{Binding CodeFormatters}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <ContextMenu x:Key="CopyGeneratedMenu" ItemsSource="{Binding PaletteFormats}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyGeneratedAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <ContextMenu x:Key="CopyPaletteMenu" ItemsSource="{Binding PaletteFormats}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyActivePaletteAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <!-- Icono de captura (mira) -->
        <Geometry x:Key="CrosshairGeometry">M8,1 V5 M8,11 V15 M1,8 H5 M11,8 H15 M8,3.2 A4.8,4.8 0 1 1 7.99,3.2 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid Margin="14,6,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Barra superior ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botones de ventana a la izquierda (opcional) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-6,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding WindowButtonsOnLeft, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="18" Height="18" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4D4D" Offset="0"/>
                                <GradientStop Color="#FFC94D" Offset="0.3"/>
                                <GradientStop Color="#4DD98A" Offset="0.55"/>
                                <GradientStop Color="#4D8BFF" Offset="0.8"/>
                                <GradientStop Color="#B44DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Matiz" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="6,2,20,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" Padding="12,6"
                            AutomationProperties.Name="Capturar color de la pantalla" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ToolTip>
                            <TextBlock>Captura cualquier píxel visible del escritorio (cualquier monitor). Click confirma, Esc cancela, flechas mueven 1 px.</TextBlock>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CrosshairGeometry}" Stroke="{DynamicResource InverseTextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="None" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Capturar" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CaptureHotkey}" Opacity="0.6" Margin="8,0,0,0" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleImageModeCommand}" Margin="8,0,0,0" ToolTip="Tomar colores de una imagen (Ctrl+O, arrastrar o pegar)"
                            AutomationProperties.Name="Imagen" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Imagen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="Deshacer color (Ctrl+Z)" AutomationProperties.Name="Deshacer"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" ToolTip="Rehacer color (Ctrl+Y)" AutomationProperties.Name="Rehacer"/>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" Margin="6,0"/>
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE718;" IsChecked="{Binding AlwaysOnTop}" ToolTip="Siempre visible" AutomationProperties.Name="Siempre visible"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE706;" Command="{Binding CycleThemeCommand}" ToolTip="Cambiar tema claro/oscuro" AutomationProperties.Name="Cambiar tema"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="Ajustes" AutomationProperties.Name="Ajustes"/>
                </StackPanel>

                <!-- Botones de ventana a la derecha (por defecto) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,-6,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding WindowButtonsOnLeft, Converter={StaticResource InvBoolToVis}}">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Cerrar" AutomationProperties.Name="Cerrar"/>
                </StackPanel>
            </Grid>

            <!-- ================= Zona principal ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Selector -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsImageMode, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <c:ColorWheel x:Name="Wheel" Hue="{Binding Hue}" Saturation="{Binding Saturation}" Gamma="{Binding WheelGamma}"
                                          CommitCommand="{Binding CommitPickerCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Markers="{Binding WheelMarkers}" MarkerClickCommand="{Binding SelectWheelMarkerCommand}" MarkerActivateCommand="{Binding ActivateWheelMarkerCommand}"
                                          ToolTip="Ángulo = tono · distancia al centro = saturación. Shift para ajuste fino; flechas con la rueda enfocada."/>
                            <c:BrightnessSlider Grid.Column="1" Hue="{Binding Hue}" Saturation="{Binding Saturation}" Value="{Binding Brightness}"
                                                CommitCommand="{Binding CommitPickerCommand}" Margin="6,6,0,6" ToolTip="Brillo: del color a 100% (arriba) hasta negro"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ENFOQUE" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Grid.Column="1" Text="Vivo" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <Slider Grid.Column="2" Minimum="-1" Maximum="1" Value="{Binding WheelFocus}" SmallChange="0.05" LargeChange="0.25"
                                        AutomationProperties.Name="Enfoque de la rueda: vivo a pastel"
                                        ToolTip="Distribución de la saturación en la rueda: más espacio para colores vivos (izquierda) o pastel (derecha). No cambia el color."/>
                                <TextBlock Grid.Column="3" Text="Pastel" Style="{StaticResource Muted}" Margin="8,0,4,0"/>
                                <Button Grid.Column="4" Style="{StaticResource SmallIconButton}" Content="&#xE72C;" Command="{Binding ResetFocusCommand}" ToolTip="Distribución lineal" AutomationProperties.Name="Restablecer enfoque"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="H" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding HueDeg}" Minimum="0" Maximum="360" Decimals="1" Wrap="True" Width="74" AutomationProperties.Name="Tono en grados"/>
                                <TextBlock Text="°" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <TextBlock Text="S" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding SatPct}" Minimum="0" Maximum="100" Width="54" AutomationProperties.Name="Saturación en porcentaje"/>
                                <TextBlock Text="%" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <TextBlock Text="B" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding BriPct}" Minimum="0" Maximum="100" Width="54" AutomationProperties.Name="Brillo en porcentaje"/>
                                <TextBlock Text="%" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <Button Content="Gris equivalente" Command="{Binding GrayEquivalentCommand}" Padding="9,4"
                                        ToolTip="Convierte el color al gris de igual luminosidad perceptual (OKLab L)"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="GRISES" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                                <c:GrayStrip Grid.Column="1" Value="{Binding GrayValue}" CommitCommand="{Binding CommitGrayCommand}"
                                             ToolTip="Luminosidad: 100 = blanco, 0 = negro"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Visor de imagen -->
                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CloseImageCommand}" ToolTip="Volver al selector (Esc)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Selector" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenImageCommand}" Content="Abrir…" Margin="6,0,0,0" ToolTip="Abrir imagen (Ctrl+O)"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ImageInfo}" Style="{StaticResource Muted}" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <c:NumericBox Value="{Binding ExtractCount}" Minimum="3" Maximum="10" Width="44" ToolTip="Número de colores (3–10)" AutomationProperties.Name="Número de colores a extraer"/>
                                <Button Command="{Binding ExtractColorsCommand}" Content="Extraer colores" Margin="6,0,0,0" ToolTip="Detecta los colores predominantes de la imagen"/>
                            </StackPanel>
                        </Grid>
                        <c:ImageCanvas Grid.Row="1" Source="{Binding ImageSource}" PickCommand="{Binding PickImageColorCommand}" Margin="1,0,1,1"
                                       ToolTip="Click: tomar color · Arrastrar: mover · Rueda: zoom"/>
                    </Grid>
                </Border>

                <!-- Color actual -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Height="84" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="8" Background="{StaticResource CheckerBrush}" Visibility="{Binding HasAlpha, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding PreviousBrush}" Command="{Binding RestorePreviousCommand}"
                                        ToolTip="Color anterior: click para volver a él" AutomationProperties.Name="Volver al color anterior">
                                    <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,8">
                                        <TextBlock Text="Anterior" FontSize="10.5" Foreground="{Binding PreviousForeground}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding PreviousHex}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{Binding PreviousForeground}"/>
                                    </StackPanel>
                                </Button>
                                <Border Grid.Column="1" Background="{Binding CurrentBrush}" CornerRadius="0,8,8,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,1">
                                    <StackPanel VerticalAlignment="Bottom" Margin="12,0,0,10">
                                        <TextBlock Text="Actual" FontSize="10.5" Foreground="{Binding CurrentForeground}" Opacity="0.8"/>
                                        <TextBlock Text="{Binding CurrentHex}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{Binding CurrentForeground}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBox Text="{Binding HexInput, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="14" Padding="8,4"
                                     Tag="HEX, rgb(), hsl(), 0xAARRGGBB…" c:Behaviors.CommitCommand="{Binding ApplyHexCommand}"
                                     c:Behaviors.IsInvalid="{Binding HexInvalid}" AutomationProperties.Name="Color en HEX u otro formato"
                                     ToolTip="Escribe o pega un color en cualquier formato y pulsa Enter"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Text="R" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding RValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="Rojo"/>
                                <TextBlock Text="G" Style="{StaticResource SectionTitle}" Margin="12,0,6,0"/>
                                <c:NumericBox Value="{Binding GValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="Verde"/>
                                <TextBlock Text="B" Style="{StaticResource SectionTitle}" Margin="12,0,6,0"/>
                                <c:NumericBox Value="{Binding BValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="Azul"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AlphaText}" Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding HasAlpha, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding FormatRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FormatRow">
                                        <Grid Margin="0,1" Background="Transparent" ToolTip="{Binding Tooltip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE8C8;"
                                                    Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Copiar" AutomationProperties.Name="{Binding Label, StringFormat=Copiar {0}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ToggleButton IsChecked="{Binding ShowMoreFormats}" Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource TextMutedBrush}" FocusVisualStyle="{StaticResource FocusVisual}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter Margin="0,2"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="Más formatos"/> <Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"/>
                                </TextBlock>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding ExtraFormatRows}" Focusable="False" Visibility="{Binding ShowMoreFormats, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FormatRow">
                                        <Grid Margin="0,1" ToolTip="{Binding Tooltip}" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE8C8;"
                                                    Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="Copiar" AutomationProperties.Name="{Binding Label, StringFormat=Copiar {0}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Copiar todo" Command="{Binding CopyAllCommand}" Margin="0,0,6,6" ToolTip="HEX, RGB, HSL, HSV y CMYK en un bloque"/>
                                <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyAsMenu}" Margin="0,0,6,6" ToolTip="Copiar como fragmento de código">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Copiar como" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="+ Paleta" Command="{Binding AddCurrentToPaletteCommand}" Margin="0,0,6,6" ToolTip="Agregar a la paleta activa (Ctrl+S)"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================= Recientes ================= -->
            <Grid Grid.Row="2" Margin="2,10,0,0" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="RECIENTES" Style="{StaticResource SectionTitle}"/>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding HistoryItems}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SwatchItem">
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" Width="22" Height="22" Margin="0,0,5,0"
                                        Command="{Binding DataContext.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Usar como color actual" Command="{Binding PlacementTarget.Command, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copiar HEX" Command="{Binding PlacementTarget.Tag.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Column="1" Text="Los colores capturados, introducidos o copiados aparecerán aquí" Style="{StaticResource Muted}" FontSize="11.5"
                           Visibility="{Binding HistoryItems.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=inverse}" x:Name="HistoryHint"/>
                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE894;" Command="{Binding ClearHistoryCommand}" ToolTip="Vaciar recientes" AutomationProperties.Name="Vaciar recientes"/>
            </Grid>

            <!-- ================= Paletas generadas ================= -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="Escala 50–950" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Scale}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Armonías" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Harmony}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Tints / Shades" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=TintsShades}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Neutros" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Neutrals}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="De la imagen" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Extracted}"
                                         Visibility="{Binding HasExtracted, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScaleAnchorAuto}" Margin="0,0,14,0" Content="Ancla auto" FontSize="12"
                                      ToolTip="Desactivado: el color base es siempre el 500. Activado: el base ocupa el paso de luminosidad más cercano."
                                      Visibility="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Scale}" x:Name="AnchorSwitch"/>
                            <TextBox Text="{Binding ScalePrefix, UpdateSourceTrigger=PropertyChanged}" Width="96" Tag="Prefijo" Margin="0,0,6,0" ToolTip="Prefijo de nombres al agregar o copiar (p. ej. Primary → Primary 500)"
                                     AutomationProperties.Name="Prefijo de nombres"/>
                            <Button Content="+ Agregar todo" Command="{Binding AddAllGeneratedCommand}" Margin="0,0,6,0" ToolTip="Agregar todos a la paleta activa"/>
                            <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyGeneratedMenu}" ToolTip="Copiar como CSS, JSON, Dart, C#, Tailwind…">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <DockPanel Margin="0,0,0,6" Visibility="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Harmony}">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HarmonyBalanceLightness}" Content="Luminosidad equilibrada" FontSize="12" Margin="12,0,0,0"
                              ToolTip="Activado: cada color de la armonía ajusta su brillo para tener la misma luminosidad percibida que el base (la posición en la rueda no cambia). Desactivado: todos con el mismo brillo HSV."/>
                    <ListBox ItemsSource="{Binding HarmonyKinds}" SelectedValue="{Binding HarmonyKind}" SelectedValuePath="Value" x:Name="HarmonyList">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="10,2" Margin="0,0,4,0" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="Transparent">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" x:Name="T" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InverseBgBrush}"/>
                                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding GeneratedColors}" Focusable="False" x:Name="GeneratedList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SwatchItem">
                                <Grid Margin="3,0" x:Name="CardRoot" Background="Transparent">
                                    <Grid.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </Grid.Tag>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Usar como color actual" Command="{Binding PlacementTarget.Tag.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copiar HEX" Command="{Binding PlacementTarget.Tag.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copiar RGB" Command="{Binding PlacementTarget.Tag.CopySwatchRgbCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copiar (formato principal)" Command="{Binding PlacementTarget.Tag.CopySwatchDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Agregar a la paleta activa" Command="{Binding PlacementTarget.Tag.AddSwatchToPaletteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="58"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                            Command="{Binding DataContext.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="Usar como color actual" AutomationProperties.Name="{Binding Hex}">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" Margin="7,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Ellipse Width="6" Height="6" Fill="{Binding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                     Visibility="{Binding IsBase, Converter={StaticResource BoolToVis}}" ToolTip="Color base"/>
                                        </Grid>
                                    </Button>
                                    <Border CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" Margin="-3" IsHitTestVisible="False"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                                                Visibility="{Binding IsMouseOver, ElementName=CardRoot, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE8C8;" Foreground="{Binding Foreground}" Width="22" Height="22"
                                                Command="{Binding DataContext.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Copiar HEX"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;" Foreground="{Binding Foreground}" Width="22" Height="22"
                                                Command="{Binding DataContext.AddSwatchToPaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="Agregar a la paleta activa"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Text="{Binding Hex}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="1,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Rgb}" Style="{StaticResource Muted}" FontSize="10.5" Margin="1,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= Paleta activa ================= -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleLibraryCommand}" Padding="8,4" Width="150" HorizontalContentAlignment="Left"
                            ToolTip="Biblioteca de paletas" AutomationProperties.Name="Biblioteca de paletas">
                        <StackPanel>
                            <TextBlock Text="PALETA ACTIVA" Style="{StaticResource SectionTitle}" FontSize="10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActivePaletteName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" MaxWidth="112" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0" Focusable="False">
                        <ItemsControl ItemsSource="{Binding ActivePaletteColors}" Focusable="False" x:Name="PaletteList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PaletteColorItem">
                                    <StackPanel Width="78" Margin="0,0,6,0" AllowDrop="True" Drop="PaletteSwatch_Drop" DragOver="PaletteSwatch_DragOver" Background="Transparent">
                                        <StackPanel.Tag>
                                            <Binding Path="DataContext" ElementName="PaletteList"/>
                                        </StackPanel.Tag>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Usar como color actual" Command="{Binding PlacementTarget.Tag.UsePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Copiar (formato principal)" Command="{Binding PlacementTarget.Tag.CopyPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Copiar HEX" Command="{Binding PlacementTarget.Tag.CopyPaletteColorHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Reemplazar con el color actual" Command="{Binding PlacementTarget.Tag.ReplacePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Mover a la izquierda" Command="{Binding PlacementTarget.Tag.MovePaletteColorLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="Mover a la derecha" Command="{Binding PlacementTarget.Tag.MovePaletteColorRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="Eliminar" Command="{Binding PlacementTarget.Tag.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Border Height="38" CornerRadius="6" Background="{Binding Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Cursor="Hand"
                                                PreviewMouseLeftButtonDown="PaletteSwatch_MouseDown" PreviewMouseMove="PaletteSwatch_MouseMove" MouseLeftButtonUp="PaletteSwatch_MouseUp"
                                                ToolTip="Click: usar · Arrastrar: reordenar · Click derecho: más acciones">
                                            <TextBlock Text="{Binding Hex}" Foreground="{Binding Foreground}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InlineEdit}" Tag="Sin nombre" Margin="0,3,0,0"
                                                 c:Behaviors.EnterUpdatesSource="True" AutomationProperties.Name="Nombre del color" ToolTip="Nombre (se usa al exportar)"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Column="1" Text="Paleta vacía: agrega el color actual con + o Ctrl+S, o usa «Agregar todo» en una escala." Style="{StaticResource Muted}" Margin="12,0"
                               Visibility="{Binding HasActiveColors, Converter={StaticResource InvBoolToVis}}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" Command="{Binding AddCurrentToPaletteCommand}" ToolTip="Agregar color actual (Ctrl+S)" AutomationProperties.Name="Agregar color actual a la paleta"/>
                        <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyPaletteMenu}" Margin="4,0" ToolTip="Copiar la paleta como CSS, JSON, Dart, C#, Tailwind…">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportActivePaletteImageCommand}" ToolTip="Exportar como imagen PNG (Ctrl+E)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="PNG" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Paneles laterales ================= -->
        <Border Background="{DynamicResource OverlayBrush}" x:Name="DrawerScrim" MouseLeftButtonDown="Scrim_MouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Biblioteca de paletas -->
        <Border Width="370" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsLibraryOpen, Converter={StaticResource BoolToVis}}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Paletas" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding EscapeCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Style="{StaticResource PrimaryButton}" Content="Nueva" Command="{Binding NewPaletteCommand}" Margin="0,0,6,0" ToolTip="Nueva paleta (Ctrl+N)"/>
                    <Button Content="Duplicar" Command="{Binding DuplicatePaletteCommand}" Margin="0,0,6,0"/>
                    <Button Content="Eliminar" Command="{Binding DeletePaletteCommand}" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" AutomationProperties.Name="Paletas guardadas">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PaletteItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11"/>
                                <ItemsControl ItemsSource="{Binding Preview}" Margin="0,5,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,3,0" Background="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding SelectedPalette, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="NOMBRE" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedPalette.Name, UpdateSourceTrigger=LostFocus}" c:Behaviors.EnterUpdatesSource="True" AutomationProperties.Name="Nombre de la paleta"/>
                    <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding SelectedPalette.Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             VerticalContentAlignment="Top" Tag="Opcional" AutomationProperties.Name="Descripción de la paleta"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ajustes -->
        <Border Width="390" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Ajustes" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding EscapeCommand}" ToolTip="Cerrar (Esc)" AutomationProperties.Name="Cerrar"/>
                    </Grid>

                    <TextBlock Text="APARIENCIA" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Sistema" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=System}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Claro" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Oscuro" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="Siempre visible (encima de otras ventanas)" IsChecked="{Binding AlwaysOnTop}" Margin="0,8,0,0"/>
                    <TextBlock Text="Botones de ventana (minimizar y cerrar)" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="Derecha" GroupName="winbtn" IsChecked="{Binding WindowButtonsOnLeft, Converter={StaticResource InvBool}}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Izquierda" GroupName="winbtn" IsChecked="{Binding WindowButtonsOnLeft}"/>
                    </StackPanel>

                    <TextBlock Text="CAPTURA DE PANTALLA" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="Atajo global" Margin="0,0,0,4"/>
                    <TextBox x:Name="HotkeyBox" Text="{Binding CaptureHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" IsReadOnly="True" Cursor="Hand"
                             Tag="Pulsa la combinación" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="Atajo global de captura"
                             ToolTip="Haz click y pulsa la nueva combinación (necesita Ctrl, Alt, Shift o Win)"/>
                    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Style="{StaticResource Switch}" Content="Copiar al capturar (en el formato principal)" IsChecked="{Binding CopyOnCapture}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Mostrar Matiz tras capturar" IsChecked="{Binding ShowAfterCapture}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0">
                        En el modo captura: click o Enter confirma, Esc o click derecho cancela, flechas mueven 1 px (Shift: 10 px), rueda del ratón cambia el aumento.
                        Limitaciones: en monitores HDR, juegos a pantalla completa exclusiva o contenido protegido (DRM) el valor capturado puede no coincidir con el original.
                    </TextBlock>

                    <TextBlock Text="COPIADO" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="Formato principal (Ctrl+C, captura y click en muestras)" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CodeFormatters}" SelectedItem="{Binding DefaultFormat}" DisplayMemberPath="DisplayName" MaxHeight="190"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="2" AutomationProperties.Name="Formato principal"/>
                    <CheckBox Style="{StaticResource Switch}" Content="HEX en mayúsculas" IsChecked="{Binding HexUppercase}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Incluir # en el HEX" IsChecked="{Binding HexHash}"/>

                    <TextBlock Text="DESIGN SCALE" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <CheckBox Style="{StaticResource Switch}" Content="Anclaje automático (en lugar de base en 500)" IsChecked="{Binding ScaleAnchorAuto}"/>

                    <TextBlock Text="ATAJOS" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" LineHeight="19" x:Name="ShortcutList"/>

                    <TextBlock Text="DATOS" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                    <Button Content="Abrir carpeta de datos" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>

                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,22,0,8">
                        <Run Text="Matiz"/> <Run Text="{Binding Version, Mode=OneWay, StringFormat=v{0}}"/> <Run Text="· matiz = hue, nuance"/>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Toast ================= -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,108" CornerRadius="8" Padding="14,8"
                Background="{DynamicResource InverseBgBrush}" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource InverseTextBrush}" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                <Button Content="{Binding ToastActionLabel}" Command="{Binding ToastActionCommand}" Margin="14,0,0,0" Padding="8,2"
                        Background="Transparent" Foreground="{DynamicResource InverseTextBrush}" BorderBrush="{DynamicResource InverseTextBrush}" FontWeight="SemiBold"
                        Visibility="{Binding ToastActionLabel, Converter={StaticResource NotEmptyToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
