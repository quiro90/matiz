<Window x:Class="Matiz.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:Matiz.App.Controls"
        xmlns:vm="clr-namespace:Matiz.App.ViewModels"
        xmlns:loc="clr-namespace:Matiz.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding WindowTitle}" Icon="/Matiz;component/Assets/matiz.ico" Width="1060" Height="740" MinWidth="820" MinHeight="600"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Topmost="{Binding AlwaysOnTop}" AllowDrop="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Sin barra de título del sistema: la barra superior hace de zona de arrastre (snap y redimensionado se conservan). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Menú "Copiar como" para el color actual -->
        <ContextMenu x:Key="CopyAsMenu" ItemsSource="{Binding CodeFormatters}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <ContextMenu x:Key="CopyGeneratedMenu" ItemsSource="{Binding PaletteFormats}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyGeneratedAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <ContextMenu x:Key="CopyPaletteMenu" ItemsSource="{Binding PaletteFormats}">
            <ContextMenu.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Header" Value="{Binding DisplayName}"/>
                    <Setter Property="Command" Value="{Binding DataContext.CopyActivePaletteAsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Setter Property="CommandParameter" Value="{Binding Id}"/>
                </Style>
            </ContextMenu.ItemContainerStyle>
        </ContextMenu>

        <ContextMenu x:Key="ExportPaletteMenu">
            <MenuItem Command="{Binding DataContext.ExportActivePaletteImageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="{loc:Loc palette.exportImageItem}"/>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Command="{Binding DataContext.ExportActivePaletteOverlayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE899;" FontFamily="{StaticResource IconFont}"/>
                </MenuItem.Icon>
                <MenuItem.Header>
                    <TextBlock Text="{loc:Loc palette.exportOverlayItem}"/>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <!-- Icono de captura (mira) -->
        <Geometry x:Key="CrosshairGeometry">M8,1 V5 M8,11 V15 M1,8 H5 M11,8 H15 M8,3.2 A4.8,4.8 0 1 1 7.99,3.2 Z</Geometry>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid Margin="14,6,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Barra superior ================= -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Botones de ventana a la izquierda (opcional) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="-6,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding WindowButtonsOnLeft, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="{loc:Loc common.close}" AutomationProperties.Name="{loc:Loc common.close}"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:Loc common.minimize}" AutomationProperties.Name="{loc:Loc common.minimize}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="18" Height="18" Margin="0,0,8,0">
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF4D4D" Offset="0"/>
                                <GradientStop Color="#FFC94D" Offset="0.3"/>
                                <GradientStop Color="#4DD98A" Offset="0.55"/>
                                <GradientStop Color="#4D8BFF" Offset="0.8"/>
                                <GradientStop Color="#B44DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="Matiz" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Version, StringFormat=v{0}}" FontSize="11" Foreground="{DynamicResource TextFaintBrush}" VerticalAlignment="Center" Margin="6,2,20,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CaptureCommand}" Padding="12,6"
                            AutomationProperties.Name="{loc:Loc ui.capture.automation}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.ToolTip>
                            <TextBlock Text="{loc:Loc ui.capture.tooltip}" MaxWidth="320" TextWrapping="Wrap"/>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource CrosshairGeometry}" Stroke="{DynamicResource InverseTextBrush}" StrokeThickness="1.6" Width="16" Height="16" Stretch="None" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc ui.capture}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CaptureHotkey}" Opacity="0.6" Margin="8,0,0,0" FontWeight="Normal" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleImageModeCommand}" Margin="8,0,0,0" ToolTip="{loc:Loc ui.image.tooltip}"
                            AutomationProperties.Name="{loc:Loc ui.image}" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Loc ui.image}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" ToolTip="{loc:Loc ui.undo.tooltip}" AutomationProperties.Name="{loc:Loc common.undo}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7A6;" Command="{Binding RedoCommand}" ToolTip="{loc:Loc ui.redo.tooltip}" AutomationProperties.Name="{loc:Loc ui.redo}"/>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" Margin="6,0"/>
                    <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE718;" IsChecked="{Binding AlwaysOnTop}" ToolTip="{loc:Loc ui.alwaysOnTop}" AutomationProperties.Name="{loc:Loc ui.alwaysOnTop}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE706;" Command="{Binding CycleThemeCommand}" ToolTip="{loc:Loc ui.cycleTheme.tooltip}" AutomationProperties.Name="{loc:Loc ui.cycleTheme}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Command="{Binding ToggleSettingsCommand}" ToolTip="{loc:Loc ui.settings}" AutomationProperties.Name="{loc:Loc ui.settings}"/>
                </StackPanel>

                <!-- Botones de ventana a la derecha (por defecto) -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,-6,0" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding WindowButtonsOnLeft, Converter={StaticResource InvBoolToVis}}">
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource LineBrush}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:Loc common.minimize}" AutomationProperties.Name="{loc:Loc common.minimize}"/>
                    <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="{loc:Loc common.close}" AutomationProperties.Name="{loc:Loc common.close}"/>
                </StackPanel>
            </Grid>

            <!-- ================= Zona principal ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="350"/>
                </Grid.ColumnDefinitions>

                <!-- Selector -->
                <Border Style="{StaticResource Card}" Visibility="{Binding IsImageMode, Converter={StaticResource InvBoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <c:ColorWheel x:Name="Wheel" Hue="{Binding Hue}" Saturation="{Binding Saturation}" Gamma="{Binding WheelGamma}"
                                          CommitCommand="{Binding CommitPickerCommand}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Markers="{Binding WheelMarkers}" MarkerClickCommand="{Binding SelectWheelMarkerCommand}"
                                          MarkerDoubleClickCommand="{Binding RemoveWheelMarkerCommand}"
                                          MarkerDragCommand="{Binding SetWheelMarkerOffsetCommand}" AddPointAtCommand="{Binding AddFreePointAtCommand}"
                                          ToolTip="{loc:Loc picker.wheel.tooltip}"/>
                            <c:BrightnessSlider Grid.Column="1" Hue="{Binding Hue}" Saturation="{Binding Saturation}" Value="{Binding Brightness}"
                                                CommitCommand="{Binding CommitPickerCommand}" Margin="6,6,0,6" ToolTip="{loc:Loc picker.brightness.tooltip}"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc picker.focus}" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Loc picker.vivid}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <Slider Grid.Column="2" Minimum="-1" Maximum="1" Value="{Binding WheelFocus}" SmallChange="0.05" LargeChange="0.25"
                                        AutomationProperties.Name="{loc:Loc picker.focus.automation}"
                                        ToolTip="{loc:Loc picker.focus.tooltip}"/>
                                <TextBlock Grid.Column="3" Text="{loc:Loc picker.pastel}" Style="{StaticResource Muted}" Margin="8,0,4,0"/>
                                <Button Grid.Column="4" Style="{StaticResource SmallIconButton}" Content="&#xE72C;" Command="{Binding ResetFocusCommand}" ToolTip="{loc:Loc picker.focus.reset.tooltip}" AutomationProperties.Name="{loc:Loc picker.focus.reset.automation}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="H" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding HueDeg}" Minimum="0" Maximum="360" Decimals="1" Wrap="True" Width="74" AutomationProperties.Name="{loc:Loc picker.hue.automation}"/>
                                <TextBlock Text="°" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <TextBlock Text="S" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding SatPct}" Minimum="0" Maximum="100" Width="54" AutomationProperties.Name="{loc:Loc picker.sat.automation}"/>
                                <TextBlock Text="%" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <TextBlock Text="B" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding BriPct}" Minimum="0" Maximum="100" Width="54" AutomationProperties.Name="{loc:Loc picker.bri.automation}"/>
                                <TextBlock Text="%" Style="{StaticResource Muted}" Margin="4,0,16,0"/>
                                <Button Content="{loc:Loc picker.grayEquivalent}" Command="{Binding GrayEquivalentCommand}" Padding="9,4"
                                        ToolTip="{loc:Loc picker.grayEquivalent.tooltip}"/>
                            </StackPanel>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Visor de imagen -->
                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding IsImageMode, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Command="{Binding CloseImageCommand}" ToolTip="{loc:Loc image.back.tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Loc image.back}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenImageCommand}" Content="{loc:Loc image.open}" Margin="6,0,0,0" ToolTip="{loc:Loc image.open.tooltip}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ImageInfo}" Style="{StaticResource Muted}" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc image.extractCount.label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding ExtractCount}" Minimum="1" Maximum="64" Width="44" ToolTip="{loc:Loc image.extractCount.tooltip}" AutomationProperties.Name="{loc:Loc image.extractCount.automation}"/>
                                <Button Command="{Binding ExtractColorsCommand}" Content="{loc:Loc image.extract}" Margin="6,0,0,0" ToolTip="{loc:Loc image.extract.tooltip}"/>
                            </StackPanel>
                        </Grid>
                        <c:ImageCanvas Grid.Row="1" Source="{Binding ImageSource}" PickCommand="{Binding PickImageColorCommand}" SecondaryPickCommand="{Binding AddImageSecondaryCommand}" Margin="1,0,1,1"
                                       ToolTip="{loc:Loc image.canvas.tooltip}"/>
                    </Grid>
                </Border>

                <!-- Color actual -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Grid Height="84" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="2" CornerRadius="8" Background="{StaticResource CheckerBrush}" Visibility="{Binding HasAlpha, Converter={StaticResource BoolToVis}}"/>
                                <Grid>
                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding PreviousBrush}" Command="{Binding RestorePreviousCommand}"
                                            ToolTip="{loc:Loc color.previous.tooltip}" AutomationProperties.Name="{loc:Loc color.previous.automation}">
                                        <StackPanel VerticalAlignment="Bottom" Margin="8,0,0,8">
                                            <TextBlock Text="{loc:Loc color.previous}" FontSize="10.5" Foreground="{Binding PreviousForeground}" Opacity="0.8"/>
                                            <TextBlock Text="{Binding PreviousHex}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{Binding PreviousForeground}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="1">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE8C8;" Foreground="{Binding PreviousForeground}" Width="18" Height="18" FontSize="10"
                                                Command="{Binding CopyPreviousHexCommand}" ToolTip="{loc:Loc swatch.copyHex}" AutomationProperties.Name="{loc:Loc swatch.copyHex}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;" Foreground="{Binding PreviousForeground}" Width="18" Height="18" FontSize="10"
                                                Command="{Binding AddPreviousColorToPaletteCommand}" ToolTip="{loc:Loc swatch.addToPalette}" AutomationProperties.Name="{loc:Loc swatch.addToPalette}"/>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Column="1" Background="{Binding CurrentBrush}" CornerRadius="0,8,8,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,1,1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,0,10">
                                            <TextBlock Text="{loc:Loc color.current}" FontSize="10.5" Foreground="{Binding CurrentForeground}" Opacity="0.8"/>
                                            <TextBlock Text="{Binding CurrentHex}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" Foreground="{Binding CurrentForeground}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0">
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE8C8;" Foreground="{Binding CurrentForeground}" Width="18" Height="18" FontSize="10"
                                                    Command="{Binding CopyHexCommand}" ToolTip="{loc:Loc swatch.copyHex}" AutomationProperties.Name="{loc:Loc swatch.copyHex}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;" Foreground="{Binding CurrentForeground}" Width="18" Height="18" FontSize="10"
                                                    Command="{Binding AddCurrentColorToPaletteCommand}" ToolTip="{loc:Loc swatch.addToPalette}" AutomationProperties.Name="{loc:Loc swatch.addToPalette}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <TextBox Text="{Binding HexInput, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="14" Padding="8,4"
                                     Tag="HEX, rgb(), hsl(), 0xAARRGGBB…" c:Behaviors.CommitCommand="{Binding ApplyHexCommand}"
                                     c:Behaviors.IsInvalid="{Binding HexInvalid}" AutomationProperties.Name="{loc:Loc color.hex.automation}"
                                     ToolTip="{loc:Loc color.hex.tooltip}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                <TextBlock Text="R" Style="{StaticResource SectionTitle}" Margin="0,0,6,0"/>
                                <c:NumericBox Value="{Binding RValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="{loc:Loc color.r.automation}"/>
                                <TextBlock Text="G" Style="{StaticResource SectionTitle}" Margin="12,0,6,0"/>
                                <c:NumericBox Value="{Binding GValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="{loc:Loc color.g.automation}"/>
                                <TextBlock Text="B" Style="{StaticResource SectionTitle}" Margin="12,0,6,0"/>
                                <c:NumericBox Value="{Binding BValue}" Minimum="0" Maximum="255" Width="56" AutomationProperties.Name="{loc:Loc color.b.automation}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding AlphaText}" Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding HasAlpha, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding FormatRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FormatRow">
                                        <Grid Margin="0,1" Background="Transparent" ToolTip="{Binding Tooltip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE8C8;"
                                                    Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc common.copy}" AutomationProperties.Name="{Binding CopyAutomation}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ToggleButton IsChecked="{Binding ShowMoreFormats}" Margin="0,4,0,0" HorizontalAlignment="Left" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                          Foreground="{DynamicResource TextMutedBrush}" FocusVisualStyle="{StaticResource FocusVisual}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter Margin="0,2"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="{loc:Loc color.moreFormats}"/> <Run Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"/>
                                </TextBlock>
                            </ToggleButton>
                            <ItemsControl ItemsSource="{Binding ExtraFormatRows}" Focusable="False" Visibility="{Binding ShowMoreFormats, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FormatRow">
                                        <Grid Margin="0,1" ToolTip="{Binding Tooltip}" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE8C8;"
                                                    Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc common.copy}" AutomationProperties.Name="{Binding CopyAutomation}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="{loc:Loc color.copyAll}" Command="{Binding CopyAllCommand}" Margin="0,0,6,6" ToolTip="{loc:Loc color.copyAll.tooltip}"/>
                                <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyAsMenu}" Margin="0,0,6,6" ToolTip="{loc:Loc color.copyAs.tooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc color.copyAs}" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="{loc:Loc color.addToPalette}" Command="{Binding AddCurrentToPaletteCommand}" Margin="0,0,6,6" ToolTip="{loc:Loc color.addToPalette.tooltip}"/>
                                <Button Content="{loc:Loc export.overlay}" Command="{Binding ExportCurrentPreviousOverlayCommand}" Margin="0,0,6,6" ToolTip="{loc:Loc overlay.button.tooltip}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ================= Recientes ================= -->
            <Grid Grid.Row="2" Margin="2,10,0,0" Height="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{loc:Loc history.title}" Style="{StaticResource SectionTitle}"/>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding HistoryItems}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SwatchItem">
                                <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}" Width="22" Height="22" Margin="0,0,5,0"
                                        Command="{Binding DataContext.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc swatch.useAsCurrent}" Command="{Binding PlacementTarget.Command, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{loc:Loc swatch.copyHex}" Command="{Binding PlacementTarget.Tag.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                    <Button.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </Button.Tag>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Column="1" Text="{loc:Loc history.empty}" Style="{StaticResource Muted}" FontSize="11.5"
                           Visibility="{Binding HistoryItems.Count, Converter={StaticResource NotEmptyToVis}, ConverterParameter=inverse}" x:Name="HistoryHint"/>
                <Button Grid.Column="2" Style="{StaticResource SmallIconButton}" Content="&#xE894;" Command="{Binding ClearHistoryCommand}" ToolTip="{loc:Loc history.clear}" AutomationProperties.Name="{loc:Loc history.clear}"/>
            </Grid>

            <!-- ================= Paletas generadas ================= -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc gen.tab.scale}" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Scale}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="Tints / Shades" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=TintsShades}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc gen.tab.neutrals}" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Neutrals}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc gen.tab.harmony}" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Harmony}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc gen.tab.free}" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Free}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc gen.tab.extracted}" GroupName="gen" IsChecked="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Extracted}"
                                         Visibility="{Binding HasExtracted, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScaleAnchorAuto}" Margin="0,0,14,0" Content="{loc:Loc gen.autoAnchor}" FontSize="12"
                                      ToolTip="{loc:Loc gen.autoAnchor.tooltip}"
                                      Visibility="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Scale}" x:Name="AnchorSwitch"/>
                            <TextBox Text="{Binding ScalePrefix, UpdateSourceTrigger=PropertyChanged}" Width="96" Tag="{loc:Loc gen.prefix.placeholder}" Margin="0,0,6,0" ToolTip="{loc:Loc gen.prefix.tooltip}"
                                     AutomationProperties.Name="{loc:Loc gen.prefix.automation}"/>
                            <Button Content="{loc:Loc gen.addAll}" Command="{Binding AddAllGeneratedCommand}" Margin="0,0,6,0" ToolTip="{loc:Loc gen.addAll.tooltip}"/>
                            <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyGeneratedMenu}" ToolTip="{loc:Loc gen.copy.tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{loc:Loc common.copy}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Fila del "+": siempre visible y a la misma altura en todas las pestañas (alineada arriba,
                         aunque los chips de armonía envuelvan); "Equilibrar" y "Borrar" solo en Armonías/Personalizado. -->
                    <DockPanel Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding HarmonyBalanceLightness}" Content="{loc:Loc gen.balance}" FontSize="12" Margin="12,0,0,0"
                              VerticalAlignment="Top" ToolTip="{loc:Loc gen.balance.tooltip}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Harmony}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Free}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Command="{Binding AddFreePointCommand}" Margin="0,0,12,0" VerticalAlignment="Top"
                            ToolTip="{loc:Loc gen.addPoint.tooltip}" AutomationProperties.Name="{loc:Loc gen.addPoint}">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"/>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}" Command="{Binding ClearFreePointsCommand}" Margin="0,0,6,0" VerticalAlignment="Top"
                            Content="{loc:Loc gen.clearPoints}" ToolTip="{loc:Loc gen.clearPoints.tooltip}" AutomationProperties.Name="{loc:Loc gen.clearPoints}"
                            Visibility="{Binding CanRemoveFreePoints, Converter={StaticResource BoolToVis}}"/>
                    <ListBox ItemsSource="{Binding HarmonyKinds}" SelectedValue="{Binding HarmonyKind}" SelectedValuePath="Value" x:Name="HarmonyList">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GeneratedTab, Converter={StaticResource EnumEquals}, ConverterParameter=Harmony}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="10" Padding="10,2" Margin="0,0,4,0" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="Transparent">
                                                <TextBlock Text="{Binding Name}" FontSize="11.5" x:Name="T" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InverseBgBrush}"/>
                                                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource InverseTextBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding GeneratedColors}" Focusable="False" x:Name="GeneratedList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SwatchItem">
                                <Grid Margin="3,0" Background="Transparent" x:Name="GenCard">
                                    <Grid.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </Grid.Tag>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc swatch.useAsCurrent}" Command="{Binding PlacementTarget.Tag.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{loc:Loc swatch.copyHex}" Command="{Binding PlacementTarget.Tag.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{loc:Loc swatch.copyRgb}" Command="{Binding PlacementTarget.Tag.CopySwatchRgbCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{loc:Loc swatch.copyDefault}" Command="{Binding PlacementTarget.Tag.CopySwatchDefaultCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="{loc:Loc swatch.addToPalette}" Command="{Binding PlacementTarget.Tag.AddSwatchToPaletteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="58"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Style="{StaticResource SwatchButton}" Background="{Binding Brush}"
                                            Command="{Binding DataContext.UseSwatchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc swatch.useAsCurrent}" AutomationProperties.Name="{Binding Hex}">
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold" Margin="7,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                            <Ellipse Width="6" Height="6" Fill="{Binding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                                     Visibility="{Binding IsBase, Converter={StaticResource BoolToVis}}" ToolTip="{loc:Loc swatch.colorBase.tooltip}"/>
                                        </Grid>
                                    </Button>
                                    <Border CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource TextBrush}" Margin="-3" IsHitTestVisible="False"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3,0,0,3">
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE8C8;" Foreground="{Binding Foreground}" Width="22" Height="22"
                                                Command="{Binding DataContext.CopySwatchHexCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc swatch.copyHex}"/>
                                        <Button Style="{StaticResource SmallIconButton}" Content="&#xE710;" Foreground="{Binding Foreground}" Width="22" Height="22"
                                                Command="{Binding DataContext.AddSwatchToPaletteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{loc:Loc swatch.addToPalette}"/>
                                    </StackPanel>
                                    <Button Content="&#xE738;" Foreground="{Binding Foreground}" FontSize="10" Width="20" Height="20"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3" Panel.ZIndex="1"
                                            Command="{Binding DataContext.RemoveFreePointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                            ToolTip="{loc:Loc swatch.removePoint}" AutomationProperties.Name="{loc:Loc swatch.removePoint}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SmallIconButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMouseOver, ElementName=GenCard}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.CanRemoveFreePoints, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <TextBlock Grid.Row="1" Text="{Binding Hex}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Margin="1,5,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Rgb}" Style="{StaticResource Muted}" FontSize="10.5" Margin="1,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= Paleta activa ================= -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleLibraryCommand}" Padding="8,4" Width="150" HorizontalContentAlignment="Left"
                            ToolTip="{loc:Loc library.title}" AutomationProperties.Name="{loc:Loc library.title}">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc palette.active.title}" Style="{StaticResource SectionTitle}" FontSize="10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ActivePaletteName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" MaxWidth="112" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,2,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0" Focusable="False"
                              AllowDrop="True" Drop="PaletteList_Drop" DragOver="PaletteList_DragOver" DragLeave="PaletteList_DragLeave">
                        <ItemsControl ItemsSource="{Binding ActivePaletteColors}" Focusable="False" x:Name="PaletteList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PaletteColorItem">
                                    <StackPanel Width="78" Margin="0,0,6,0" AllowDrop="True" Background="Transparent">
                                        <StackPanel.Tag>
                                            <Binding Path="DataContext" ElementName="PaletteList"/>
                                        </StackPanel.Tag>
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Loc swatch.useAsCurrent}" Command="{Binding PlacementTarget.Tag.UsePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{loc:Loc swatch.copyDefault}" Command="{Binding PlacementTarget.Tag.CopyPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{loc:Loc swatch.copyHex}" Command="{Binding PlacementTarget.Tag.CopyPaletteColorHexCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:Loc palette.replaceWithCurrent}" Command="{Binding PlacementTarget.Tag.ReplacePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{loc:Loc palette.moveLeft}" Command="{Binding PlacementTarget.Tag.MovePaletteColorLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <MenuItem Header="{loc:Loc palette.moveRight}" Command="{Binding PlacementTarget.Tag.MovePaletteColorRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:Loc common.delete}" Command="{Binding PlacementTarget.Tag.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Grid x:Name="SwatchRoot">
                                            <Border Height="38" CornerRadius="6" Background="{Binding Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="PaletteSwatch_MouseDown" PreviewMouseMove="PaletteSwatch_MouseMove" MouseLeftButtonUp="PaletteSwatch_MouseUp"
                                                    ToolTip="{loc:Loc palette.color.tooltip}">
                                                <TextBlock Text="{Binding Hex}" Foreground="{Binding Foreground}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <!-- Hint de arrastre: aparece al pasar el mouse sobre la tarjeta -->
                                            <TextBlock Text="&#xE7C9;" FontFamily="{StaticResource IconFont}" FontSize="9" Width="16" Height="16" Foreground="{Binding Foreground}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,3,0,0" Panel.ZIndex="1" IsHitTestVisible="False"
                                                       Visibility="{Binding IsMouseOver, ElementName=SwatchRoot, Converter={StaticResource BoolToVis}}"
                                                       ToolTip="{loc:Loc palette.drag.tooltip}"/>
                                            <Button Style="{StaticResource SmallIconButton}" Content="&#xE711;" Width="16" Height="16" FontSize="9"
                                                    Foreground="{Binding Foreground}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="1"
                                                    Command="{Binding DataContext.RemovePaletteColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    ToolTip="{loc:Loc common.delete}" AutomationProperties.Name="{loc:Loc common.delete}"
                                                    Visibility="{Binding IsMouseOver, ElementName=SwatchRoot, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Style="{StaticResource InlineEdit}" Tag="{loc:Loc palette.namePlaceholder}" Margin="0,3,0,0"
                                                 c:Behaviors.EnterUpdatesSource="True" AutomationProperties.Name="{loc:Loc palette.colorName.automation}" ToolTip="{loc:Loc palette.colorName.tooltip}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Column="1" Text="{loc:Loc palette.empty}" Style="{StaticResource Muted}" Margin="12,0" TextWrapping="Wrap" MaxWidth="430"
                               Visibility="{Binding HasActiveColors, Converter={StaticResource InvBoolToVis}}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="OpenMenu_Click" ContextMenu="{StaticResource CopyPaletteMenu}" Margin="4,0" ToolTip="{loc:Loc palette.copy.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:Loc common.copy}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Click="OpenMenu_Click" ContextMenu="{StaticResource ExportPaletteMenu}" ToolTip="{loc:Loc palette.export.tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Loc palette.export}" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Paneles laterales ================= -->
        <Border Background="{DynamicResource OverlayBrush}" x:Name="DrawerScrim" MouseLeftButtonDown="Scrim_MouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Biblioteca de paletas -->
        <Border Width="370" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsLibraryOpen, Converter={StaticResource BoolToVis}}" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{loc:Loc library.title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding EscapeCommand}" ToolTip="{loc:Loc common.close.esc}" AutomationProperties.Name="{loc:Loc common.close}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc library.new}" Command="{Binding NewPaletteCommand}" Margin="0,0,6,0" ToolTip="{loc:Loc library.new.tooltip}"/>
                    <Button Content="{loc:Loc library.reload}" Command="{Binding ReloadPaletteToFreeCommand}" Margin="0,0,6,0" ToolTip="{loc:Loc library.reload.tooltip}"/>
                    <Button Content="{loc:Loc library.duplicate}" Command="{Binding DuplicatePaletteCommand}" Margin="0,0,6,0"/>
                    <Button Content="{loc:Loc common.delete}" Command="{Binding DeletePaletteCommand}" Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}" AutomationProperties.Name="{loc:Loc library.saved}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PaletteItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" FontSize="11"/>
                                <ItemsControl ItemsSource="{Binding Preview}" Margin="0,5,0,0" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,3,0" Background="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding SelectedPalette, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Text="{loc:Loc library.name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SelectedPalette.Name, UpdateSourceTrigger=LostFocus}" c:Behaviors.EnterUpdatesSource="True" AutomationProperties.Name="{loc:Loc library.name.automation}"/>
                    <TextBlock Text="{loc:Loc library.description}" Style="{StaticResource SectionTitle}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding SelectedPalette.Description, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                             VerticalContentAlignment="Top" Tag="{loc:Loc library.descriptionPlaceholder}" AutomationProperties.Name="{loc:Loc library.description.automation}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ajustes -->
        <Border Width="390" HorizontalAlignment="Right" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Loc settings.title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" Command="{Binding EscapeCommand}" ToolTip="{loc:Loc common.close.esc}" AutomationProperties.Name="{loc:Loc common.close}"
                                WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" LineHeight="19" Margin="0,2,0,6" TextWrapping="Wrap">
                        <Run Text="Matiz"/> <Run Text="{Binding Version, Mode=OneWay, StringFormat=v{0}}"/> <Run Text="by"/> <Run Text="Juan Quiroga" FontWeight="Bold"/> <Run Text=" - "/> <Hyperlink NavigateUri="https://www.instagram.com/juanquirogaart/" RequestNavigate="ExternalHyperlink_Click" Foreground="{DynamicResource TextBrush}">@juanquirogaart</Hyperlink>
                    </TextBlock>

                    <!-- Apoyar el proyecto: Cafecito (imagen oficial del botón) y PayPal (estilo del vínculo de pago) -->
                    <TextBlock Text="{loc:Loc settings.support.hint}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,8,0,3" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Style="{StaticResource GhostButton}" Padding="0"
                                Click="ExternalLinkButton_Click" Tag="https://cafecito.app/juanquiroga"
                                AutomationProperties.Name="{loc:Loc settings.support.cafecito}" ToolTip="{loc:Loc settings.support.cafecito}">
                            <Image Source="/Matiz;component/Assets/cafecito.png" Width="152" Height="31" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Background="#FFD140" Foreground="#FF000000" FontWeight="Bold"
                                Width="150" Height="31" Margin="7,0,0,0" Content="{loc:Loc settings.support.donate}"
                                Click="ExternalLinkButton_Click" Tag="https://www.paypal.com/ncp/payment/PJXDUSBHSE8DE"
                                AutomationProperties.Name="{loc:Loc settings.support.paypal}" ToolTip="{loc:Loc settings.support.paypal}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc settings.section.language}" Style="{StaticResource SectionTitle}" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="English" GroupName="lang"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=English}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="Español" GroupName="lang"
                                     IsChecked="{Binding Language, Converter={StaticResource EnumEquals}, ConverterParameter=Spanish}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc settings.section.appearance}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc theme.system}" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=System}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc theme.light}" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Light}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc theme.dark}" GroupName="theme" IsChecked="{Binding ThemePreference, Converter={StaticResource EnumEquals}, ConverterParameter=Dark}"/>
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.alwaysOnTop}" IsChecked="{Binding AlwaysOnTop}" Margin="0,8,0,0"/>
                    <TextBlock Text="{loc:Loc settings.windowButtons}" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc settings.windowButtons.right}" GroupName="winbtn" IsChecked="{Binding WindowButtonsOnLeft, Converter={StaticResource InvBool}}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{loc:Loc settings.windowButtons.left}" GroupName="winbtn" IsChecked="{Binding WindowButtonsOnLeft}"/>
                    </StackPanel>

                    <TextBlock Text="{loc:Loc settings.section.capture}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="{loc:Loc settings.hotkey}" Margin="0,0,0,4"/>
                    <TextBox x:Name="HotkeyBox" Text="{Binding CaptureHotkey, Mode=OneWay}" PreviewKeyDown="HotkeyBox_PreviewKeyDown" IsReadOnly="True" Cursor="Hand"
                             Tag="{loc:Loc settings.hotkey.placeholder}" FontFamily="{StaticResource MonoFont}" AutomationProperties.Name="{loc:Loc settings.hotkey.automation}"
                             ToolTip="{loc:Loc settings.hotkey.tooltip}"/>
                    <TextBlock Text="{Binding HotkeyStatus}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyFailed}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.copyOnCapture}" IsChecked="{Binding CopyOnCapture}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.showAfterCapture}" IsChecked="{Binding ShowAfterCapture}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0">
                        <Run Text="{loc:Loc settings.captureHelp}"/>
                    </TextBlock>

                    <TextBlock Text="{loc:Loc settings.section.copy}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="{loc:Loc settings.mainFormat}" Margin="0,0,0,4"/>
                    <ListBox ItemsSource="{Binding CodeFormatters}" SelectedItem="{Binding DefaultFormat}" DisplayMemberPath="DisplayName" MaxHeight="190"
                             BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="2" AutomationProperties.Name="{loc:Loc settings.mainFormat.automation}"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.hexUppercase}" IsChecked="{Binding HexUppercase}" Margin="0,10,0,0"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.hexHash}" IsChecked="{Binding HexHash}"/>

                    <TextBlock Text="DESIGN SCALE" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <CheckBox Style="{StaticResource Switch}" Content="{loc:Loc settings.autoAnchor}" IsChecked="{Binding ScaleAnchorAuto}"/>

                    <TextBlock Text="{loc:Loc settings.section.shortcuts}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" LineHeight="19" x:Name="ShortcutList"/>

                    <TextBlock Text="{loc:Loc settings.section.data}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6"/>
                    <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap"/>
                    <Button Content="{loc:Loc settings.openDataFolder}" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ================= Toast ================= -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,108" CornerRadius="8" Padding="14,8"
                Background="{DynamicResource InverseBgBrush}" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                AutomationProperties.LiveSetting="Polite">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource InverseTextBrush}" VerticalAlignment="Center" FontFamily="{StaticResource UiFont}" MaxWidth="560" TextTrimming="CharacterEllipsis"/>
                <Button Content="{Binding ToastActionLabel}" Command="{Binding ToastActionCommand}" Margin="14,0,0,0" Padding="8,2"
                        Background="Transparent" Foreground="{DynamicResource InverseTextBrush}" BorderBrush="{DynamicResource InverseTextBrush}" FontWeight="SemiBold"
                        Visibility="{Binding ToastActionLabel, Converter={StaticResource NotEmptyToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
